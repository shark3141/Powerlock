/* app.wxss - 全局样式 */
page {
  background: linear-gradient(145deg, #f0f4f8 0%, #e6ecf2 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* 全局按钮重置 */
button {
  background: initial;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  font-size: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}