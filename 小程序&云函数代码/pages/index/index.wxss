/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(145deg, #f0f4f8 0%, #e6ecf2 100%);
}

.header {
  margin-bottom: 40rpx;
  padding-left: 10rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1e2b3c;
  letter-spacing: 2rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #5e7a93;
  margin-top: 8rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 30rpx 25rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 10, 30, 0.08);
  margin-bottom: 30rpx;
  flex: 1;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1e2b3c;
  margin-bottom: 30rpx;
  border-left: 10rpx solid #2a7de1;
  padding-left: 20rpx;
}

.status-item {
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #edf2f7;
  padding-bottom: 30rpx;
}

.status-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.status-label {
  display: block;
  font-size: 28rpx;
  color: #4a627a;
  margin-bottom: 18rpx;
  font-weight: 500;
}

/* 模式切换样式 */
.mode-control {
  display: flex;
  gap: 20rpx;
}

.mode-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 24rpx;
  border: 2rpx solid #e0e8f0;
  transition: all 0.2s;
  position: relative;
}

.mode-option.active {
  background: #2a7de1;
  border-color: #2a7de1;
}

.mode-option.active .mode-icon,
.mode-option.active .mode-text,
.mode-option.active .mode-loading {
  color: #ffffff;
}

.mode-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.mode-text {
  font-size: 28rpx;
  color: #1e2b3c;
  font-weight: 500;
}

.mode-loading {
  font-size: 22rpx;
  color: #7a8b9f;
  margin-top: 6rpx;
}

.mode-hint {
  display: block;
  font-size: 24rpx;
  color: #7a8b9f;
  margin-top: 12rpx;
}

.status-value {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border-radius: 24rpx;
  border-left: 6rpx solid #b0c8dd;
}

.status-value.active {
  border-left-color: #2ecc71;
  background: #f0fff4;
}

.status-value.inactive {
  border-left-color: #e74c3c;
  background: #fff5f5;
}

.status-value.charging {
  border-left-color: #f39c12;
  background: #fff9e6;
}

.status-value.not-charging {
  border-left-color: #95a5a6;
  background: #f8f9fa;
}

.status-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
  width: 60rpx;
  text-align: center;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e2b3c;
}

.cmd-item {
  border-bottom: none !important;
}

.cmd-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20rpx;
}

.cmd-value {
  display: flex;
  align-items: center;
  flex: 1;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border-radius: 24rpx;
  border-left: 6rpx solid #b0c8dd;
}

.cmd-value.cmd-on {
  border-left-color: #3498db;
  background: #eaf5ff;
}

.cmd-value.cmd-off {
  border-left-color: #7f8c8d;
  background: #ecf0f1;
}

.cmd-btn {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  background: #2a7de1;
  color: white;
  border: none;
  box-shadow: 0 6rpx 12rpx rgba(42, 125, 225, 0.25);
  padding: 0;
  margin: 0;
  text-align: center;
}

.cmd-btn.btn-off {
  background: #e74c3c;
  box-shadow: 0 6rpx 12rpx rgba(231, 76, 60, 0.25);
}

.cmd-btn.btn-disabled {
  background: #a0b8cc;
  box-shadow: none;
  opacity: 0.6;
}

.cmd-btn-hover {
  opacity: 0.8;
  transform: scale(0.97);
}

.cmd-btn[disabled] {
  background: #a0b8cc;
  box-shadow: none;
}

.cmd-hint {
  display: block;
  font-size: 24rpx;
  color: #7a8b9f;
  margin-top: 12rpx;
}

.action-bar {
  display: flex;
  justify-content: center;
  margin: 20rpx 0 30rpx;
}

.refresh-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 360rpx;
  height: 88rpx;
  background: #ffffff;
  border-radius: 48rpx;
  border: 1rpx solid #cddae6;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: 500;
}

.refresh-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.footer {
  text-align: center;
  margin-top: 10rpx;
}

.update-time {
  font-size: 24rpx;
  color: #7e95ab;
}

.error-msg {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #e74c3c;
  background: #ffece8;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  word-break: break-all;
}