<!-- pages/index/index.wxml -->
<view class="container">
  <view class="header">
    <text class="title">智能锁状态监控</text>
    <text class="subtitle">OneNET IoT · PowerLock</text>
  </view>

  <view class="card">
    <view class="card-title">设备实时状态</view>
    
    <!-- 模式切换 -->
    <view class="status-item mode-item">
      <text class="status-label">工作模式 (mode)</text>
      <view class="mode-control">
        <view class="mode-option {{mode ? '' : 'active'}}" bindtap="setAutoMode">
          <text class="mode-icon">🤖</text>
          <text class="mode-text">自动模式</text>
          <text class="mode-loading" wx:if="{{isPosting && !mode}}">切换中...</text>
        </view>
        <view class="mode-option {{mode ? 'active' : ''}}" bindtap="setManualMode">
          <text class="mode-icon">👆</text>
          <text class="mode-text">手动模式</text>
          <text class="mode-loading" wx:if="{{isPosting && mode}}">切换中...</text>
        </view>
      </view>
      <text class="mode-hint">{{mode ? '当前为手动模式，可控制cmd' : '当前为自动模式，cmd不可用'}}</text>
    </view>

    <!-- 锁状态 -->
    <view class="status-item">
      <text class="status-label">锁状态 (lockstate)</text>
      <view class="status-value {{lockstate ? 'active' : 'inactive'}}">
        <text class="status-icon">{{lockstate ? '🔒' : '🔓'}}</text>
        <text class="status-text">{{lockstate ? '已上锁' : '未上锁'}}</text>
      </view>
    </view>

    <!-- 充电状态 -->
    <view class="status-item">
      <text class="status-label">充电状态 (streamstate)</text>
      <view class="status-value {{streamstate ? 'charging' : 'not-charging'}}">
        <text class="status-icon">{{streamstate ? '⚡' : '🔋'}}</text>
        <text class="status-text">{{streamstate ? '充电中' : '未充电'}}</text>
      </view>
    </view>

    <!-- 手动控制 -->
    <view class="status-item cmd-item">
      <text class="status-label">手动控制 (cmd)</text>
      <view class="cmd-control">
        <view class="cmd-value {{cmd ? 'cmd-on' : 'cmd-off'}}">
          <text class="status-icon">{{cmd ? '🔛' : '📴'}}</text>
          <text class="status-text">{{cmd ? '已开启' : '已关闭'}}</text>
        </view>
        <button 
          class="cmd-btn {{cmd ? 'btn-off' : 'btn-on'}} {{mode ? '' : 'btn-disabled'}}" 
          bindtap="toggleCmd"
          loading="{{isCmdPosting}}"
          disabled="{{isCmdPosting || !mode}}"
          hover-class="cmd-btn-hover"
        >
          {{isCmdPosting ? '发送中...' : (cmd ? '关闭命令' : '开启命令')}}
        </button>
      </view>
      <text class="cmd-hint" wx:if="{{!mode}}">⚠️ 请先切换到手动模式</text>
      <text class="cmd-hint" wx:else>点击按钮发送期望值到设备</text>
    </view>
  </view>

  <view class="action-bar">
    <button class="refresh-btn" bindtap="fetchData" disabled="{{isLoading}}">
      <text class="refresh-icon">🔄</text>
      <text>{{isLoading ? '刷新中...' : '刷新状态'}}</text>
    </button>
  </view>

  <view class="footer">
    <text class="update-time">最后更新: {{lastUpdateTime || '--'}}</text>
    <text class="error-msg" wx:if="{{errorMsg}}">⚠️ {{errorMsg}}</text>
  </view>
</view>